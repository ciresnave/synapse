#[async_trait]
impl Transport for DiscoveryTransport {
    fn transport_type(&self) -> TransportType {
        TransportType::AutoDiscovery
    }

    fn capabilities(&self) -> TransportCapabilities {
        TransportCapabilities {
            reliable: true,
            real_time: true,
            broadcast: true,
            bidirectional: true,
            encrypted: true,
            network_spanning: true,
            max_message_size: 1024 * 1024, // 1MB
            features: vec![],
            supported_urgencies: vec![MessageUrgency::RealTime, MessageUrgency::Interactive],
        }
    }

    async fn can_reach(&self, _target: &TransportTarget) -> bool {
        // Minimal build: always return false
        false
    }

    async fn estimate_metrics(&self, _target: &TransportTarget) -> Result<TransportEstimate> {
        // Minimal build: return default metrics
        Ok(TransportEstimate {
            latency: Duration::from_millis(50),
            bandwidth: 1024 * 1024, // 1MB/s
            reliability: 0.95,
            cost: 0.1,
            available: true,
            confidence: 0.9,
        })
    }

    async fn start(&self) -> Result<()> {
        // Minimal build: nothing to start
        Ok(())
    }

    async fn stop(&self) -> Result<()> {
        // Minimal build: nothing to stop
        Ok(())
    }

    async fn send_message(&self, _target: &TransportTarget, message: &SecureMessage) -> Result<DeliveryReceipt> {
        // Minimal build: always fail to send
        // Prefixing unused variable with underscore for warning cleanup
        Err(SynapseError::TransportError("Service not available in minimal build".to_string()))
    }

    async fn receive_messages(&self) -> Result<Vec<IncomingMessage>> {
        // TODO: Implement message receiving based on the auto-discovery service
        Ok(Vec::new())
    }

    async fn test_connectivity(&self, _target: &TransportTarget) -> Result<ConnectivityResult> {
        // Minimal build: always return not connected
        Ok(ConnectivityResult {
            connected: false,
            rtt: None,
            quality: 0.0,
            error: Some("Service not available in minimal build".to_string()),
            details: HashMap::new(),
        })
    }

    async fn status(&self) -> TransportStatus {
        TransportStatus::Running
    }

    async fn metrics(&self) -> TransportMetrics {
        self.metrics.read().await.clone()
    }
}
